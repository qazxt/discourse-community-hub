{{! /admin/community-hub — 仅维护 hub-config.json 中的 hero_banners、sidebar_widgets }}
<div class="community-hub-admin">
  {{#if this.isLoading}}
    <p class="community-hub-muted">加载中…</p>
  {{else}}
    <div class="community-hub-section community-hub-intro">
      <h3>说明</h3>
      <p class="community-hub-muted">
        本页<strong>仅</strong>配置 <code>GET /hub-config.json</code> 中的 <code>hero_banners</code>（顶栏轮播）与 <code>sidebar_widgets</code>（侧栏幻灯片）。
        顶栏导航、预显标签、Logo、侧栏区块标题与「查看全部」等请到
        <strong>Admin → Customize → Themes → Theme settings</strong>（见文档 §三）。
      </p>
    </div>

    <div class="community-hub-section">
      <h3>顶栏轮播 (hero_banners)</h3>
      <p class="community-hub-muted">字段：title / image_url / link_url / bg_color（可选）</p>
      <div class="community-hub-actions">
        <button type="button" {{on "click" (fn this.addNew "hero")}}>Add</button>
      </div>

      <ul>
        {{#each this.heroBanners as |item idx|}}
          <li class="community-hub-item" draggable="true" data-section="hero_banners" data-index={{idx}}>
            <span>{{idx}}. {{item.title}}</span>
            <span>({{item.link_url}})</span>
            <span class="community-hub-item-actions">
              <button type="button" {{on "click" (fn this.openModal "hero" item)}}>Edit</button>
              <button type="button" {{on "click" (fn this.deleteItem "hero" item.id)}}>Delete</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </div>

    <div class="community-hub-section">
      <h3>侧栏幻灯片 (sidebar_widgets)</h3>
      <p class="community-hub-muted">字段：title / image_url / link_url</p>
      <div class="community-hub-actions">
        <button type="button" {{on "click" (fn this.addNew "sidebar")}}>Add</button>
      </div>

      <ul>
        {{#each this.sidebarWidgets as |item idx|}}
          <li class="community-hub-item" draggable="true" data-section="sidebar_widgets" data-index={{idx}}>
            <span>{{idx}}. {{item.title}}</span>
            <span>({{item.link_url}})</span>
            <span class="community-hub-item-actions">
              <button type="button" {{on "click" (fn this.openModal "sidebar" item)}}>Edit</button>
              <button type="button" {{on "click" (fn this.deleteItem "sidebar" item.id)}}>Delete</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  {{#if this.modalOpen}}
    <div class="community-hub-modal-backdrop" {{on "click" this.closeModal}}></div>
    <div class="community-hub-modal" role="dialog" aria-modal="true" {{on "click" this.stopPropagation}}>
      <h3>{{#if this.isHeroModal}}轮播卡片{{else}}侧栏幻灯片{{/if}}</h3>

      <div class="community-hub-modal-body">
        {{#if this.isHeroModal}}
          <label>标题 (title)</label>
          <Input @value={{this.modalDraft.title}} />

          <label>图片地址 (image_url)</label>
          <Input @value={{this.modalDraft.image_url}} />
          <input id="community-hub-upload-hero" type="file" accept="image/*" {{on "change" (fn this.onFileSelected "hero")}} />
          {{#if this.uploadError}}
            <p class="community-hub-error">{{this.uploadError}}</p>
          {{/if}}

          <label>跳转方式</label>
          <label class="community-hub-inline-label">
            <Input @type="radio" @name="hero_link_mode" @checked={{this.isHeroCustomLink}} {{on "change" (fn this.setLinkMode "custom")}} />
            手动填写 URL
          </label>
          <label class="community-hub-inline-label">
            <Input @type="radio" @name="hero_link_mode" @checked={{this.isHeroCategoryLink}} {{on "change" (fn this.setLinkMode "category")}} />
            选择站内分类自动生成 URL
          </label>

          {{#if this.isHeroCategoryLink}}
            <select {{on "change" (fn this.setCategoryLink "hero")}}>
              <option value="">— 请选择分类 —</option>
              {{#each this.categories as |cat|}}
                <option value={{cat.id}}>{{cat.name}}</option>
              {{/each}}
            </select>
          {{/if}}

          <label>跳转 (link_url)</label>
          <Input @value={{this.modalDraft.link_url}} @disabled={{this.isHeroCategoryLink}} />
          {{#if this.isHeroCategoryLink}}
            <p class="community-hub-muted">选择分类后会自动写入 link_url（格式 `/c/:slug/:id`）。</p>
          {{/if}}

          <label>兜底背景色 (bg_color，可选)</label>
          <Input @value={{this.modalDraft.bg_color}} placeholder="#f6ebe3" />
        {{/if}}

        {{#if this.isSidebarModal}}
          <label>标题 (title)</label>
          <Input @value={{this.modalDraft.title}} />

          <label>图片地址 (image_url)</label>
          <Input @value={{this.modalDraft.image_url}} />
          <input id="community-hub-upload-sidebar" type="file" accept="image/*" {{on "change" (fn this.onFileSelected "sidebar")}} />
          {{#if this.uploadError}}
            <p class="community-hub-error">{{this.uploadError}}</p>
          {{/if}}

          <label>跳转方式</label>
          <label class="community-hub-inline-label">
            <Input @type="radio" @name="sidebar_link_mode" @checked={{this.isSidebarCustomLink}} {{on "change" (fn this.setLinkMode "custom")}} />
            手动填写 URL
          </label>
          <label class="community-hub-inline-label">
            <Input @type="radio" @name="sidebar_link_mode" @checked={{this.isSidebarCategoryLink}} {{on "change" (fn this.setLinkMode "category")}} />
            选择站内分类自动生成 URL
          </label>

          {{#if this.isSidebarCategoryLink}}
            <select {{on "change" (fn this.setCategoryLink "sidebar")}}>
              <option value="">— 请选择分类 —</option>
              {{#each this.categories as |cat|}}
                <option value={{cat.id}}>{{cat.name}}</option>
              {{/each}}
            </select>
          {{/if}}

          <label>跳转 (link_url)</label>
          <Input @value={{this.modalDraft.link_url}} @disabled={{this.isSidebarCategoryLink}} />
          {{#if this.isSidebarCategoryLink}}
            <p class="community-hub-muted">选择分类后会自动写入 link_url。</p>
          {{/if}}
        {{/if}}
      </div>

      <div class="community-hub-modal-footer">
        <button type="button" {{on "click" this.saveModalChanges}}>保存</button>
        <button type="button" {{on "click" this.closeModal}} class="is-secondary">取消</button>
      </div>
    </div>
  {{/if}}
</div>
