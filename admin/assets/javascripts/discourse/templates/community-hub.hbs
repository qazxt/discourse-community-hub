{{! resetNamespace 路由 community-hub，URL /admin/community-hub — 字段对齐 PLUGIN-INTERFACE.md }}
<div class="community-hub-admin">
  {{#if this.isLoading}}
    <p class="community-hub-muted">加载中…</p>
  {{else}}
    <div class="community-hub-section">
      <h3>顶部导航 (nav_items)</h3>
      <p class="community-hub-muted">拖拽排序；点 Add 在弹窗内保存后写入。字段：label / url / is_external / bg_color（可选）</p>
      <div class="community-hub-actions">
        <button type="button" {{on "click" (fn this.addNew "nav")}}>Add</button>
      </div>

      <ul>
        {{#each this.navItems as |item idx|}}
          <li class="community-hub-item" draggable="true" data-section="nav_items" data-index={{idx}}>
            <span>{{idx}}. {{item.label}}</span>
            <span>({{item.url}})</span>
            <span class="community-hub-item-actions">
              <button type="button" {{on "click" (fn this.openModal "nav" item)}}>Edit</button>
              <button type="button" {{on "click" (fn this.deleteItem "nav" item.id)}}>Delete</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </div>

    <div class="community-hub-section">
      <h3>轮播卡片 (hero_banners)</h3>
      <p class="community-hub-muted">字段：title / image_url / link_url / bg_color（可选，默认 #f6ebe3）</p>
      <div class="community-hub-actions">
        <button type="button" {{on "click" (fn this.addNew "hero")}}>Add</button>
      </div>

      <ul>
        {{#each this.heroBanners as |item idx|}}
          <li class="community-hub-item" draggable="true" data-section="hero_banners" data-index={{idx}}>
            <span>{{idx}}. {{item.title}}</span>
            <span>({{item.link_url}})</span>
            <span class="community-hub-item-actions">
              <button type="button" {{on "click" (fn this.openModal "hero" item)}}>Edit</button>
              <button type="button" {{on "click" (fn this.deleteItem "hero" item.id)}}>Delete</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </div>

    <div class="community-hub-section">
      <h3>列表预显标签 (filter_quick_tags)</h3>
      <p class="community-hub-muted">字段：label / url / is_external（可选）</p>
      <div class="community-hub-actions">
        <button type="button" {{on "click" (fn this.addNew "filter")}}>Add</button>
      </div>

      <ul>
        {{#each this.filterQuickTags as |item idx|}}
          <li class="community-hub-item" draggable="true" data-section="filter_quick_tags" data-index={{idx}}>
            <span>{{idx}}. {{item.label}}</span>
            <span>({{item.url}})</span>
            <span class="community-hub-item-actions">
              <button type="button" {{on "click" (fn this.openModal "filter" item)}}>Edit</button>
              <button type="button" {{on "click" (fn this.deleteItem "filter" item.id)}}>Delete</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </div>

    <div class="community-hub-section">
      <h3>侧栏标题与「查看全部」(sidebar_section_title / sidebar_view_all)</h3>
      <p class="community-hub-muted">留空 URL 则不向前台输出「查看全部」链接。</p>
      <label>区块标题</label>
      <Input @value={{this.sidebarSectionTitle}} />

      <label>查看全部文案</label>
      <Input @value={{this.sidebarViewAll.label}} />

      <label>查看全部 URL</label>
      <Input @value={{this.sidebarViewAll.url}} />

      <label class="community-hub-inline-label">
        <Input @type="checkbox" @checked={{this.sidebarViewAll.is_external}} />
        外链（新窗口）
      </label>

      <div class="community-hub-actions">
        <button type="button" {{on "click" this.saveSidebarExtras}}>保存侧栏头区</button>
      </div>
    </div>

    <div class="community-hub-section">
      <h3>侧栏幻灯片 (sidebar_widgets)</h3>
      <p class="community-hub-muted">字段：title / image_url / link_url</p>
      <div class="community-hub-actions">
        <button type="button" {{on "click" (fn this.addNew "sidebar")}}>Add</button>
      </div>

      <ul>
        {{#each this.sidebarWidgets as |item idx|}}
          <li class="community-hub-item" draggable="true" data-section="sidebar_widgets" data-index={{idx}}>
            <span>{{idx}}. {{item.title}}</span>
            <span>({{item.link_url}})</span>
            <span class="community-hub-item-actions">
              <button type="button" {{on "click" (fn this.openModal "sidebar" item)}}>Edit</button>
              <button type="button" {{on "click" (fn this.deleteItem "sidebar" item.id)}}>Delete</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  {{#if this.modalOpen}}
    <div class="community-hub-modal-backdrop" {{on "click" this.closeModal}}></div>
    <div class="community-hub-modal" role="dialog" aria-modal="true" {{on "click" this.stopPropagation}}>
      <h3>
        {{#if this.isNavModal}}导航项{{/if}}
        {{#if this.isHeroModal}}轮播卡片{{/if}}
        {{#if this.isFilterModal}}预显标签{{/if}}
        {{#if this.isSidebarModal}}侧栏幻灯片{{/if}}
      </h3>

      <div class="community-hub-modal-body">
        {{#if this.isNavModal}}
          <label>显示文字 (label)</label>
          <Input @value={{this.modalDraft.label}} />

          <label>链接 (url)</label>
          <Input @value={{this.modalDraft.url}} />

          <label>背景色 (bg_color，可选，如 #f6ebe3)</label>
          <Input @value={{this.modalDraft.bg_color}} placeholder="#f6ebe3" />

          <label class="community-hub-inline-label">
            <Input @type="checkbox" @checked={{this.modalDraft.is_external}} />
            外链
          </label>
        {{/if}}

        {{#if this.isFilterModal}}
          <label>显示文字 (label)</label>
          <Input @value={{this.modalDraft.label}} />

          <label>链接 (url)</label>
          <Input @value={{this.modalDraft.url}} />

          <label class="community-hub-inline-label">
            <Input @type="checkbox" @checked={{this.modalDraft.is_external}} />
            外链
          </label>
        {{/if}}

        {{#if this.isHeroModal}}
          <label>标题 (title)</label>
          <Input @value={{this.modalDraft.title}} />

          <label>图片地址 (image_url)</label>
          <Input @value={{this.modalDraft.image_url}} />
          <input id="community-hub-upload-hero" type="file" accept="image/*" />
          <button type="button" {{on "click" (fn this.uploadModalImage "hero")}}>上传图片</button>
          {{#if this.uploadError}}
            <p class="community-hub-error">{{this.uploadError}}</p>
          {{/if}}

          <label>选择分类填入 link_url（可选）</label>
          <select {{on "change" (fn this.setCategoryLink "hero")}}>
            <option value="">— 不选用分类，手填下方 link_url —</option>
            {{#each this.categories as |cat|}}
              <option value={{cat.id}}>{{cat.name}}</option>
            {{/each}}
          </select>

          <label>跳转 (link_url)</label>
          <Input @value={{this.modalDraft.link_url}} />

          <label>兜底背景色 (bg_color，可选)</label>
          <Input @value={{this.modalDraft.bg_color}} placeholder="#f6ebe3" />
        {{/if}}

        {{#if this.isSidebarModal}}
          <label>标题 (title)</label>
          <Input @value={{this.modalDraft.title}} />

          <label>图片地址 (image_url)</label>
          <Input @value={{this.modalDraft.image_url}} />
          <input id="community-hub-upload-sidebar" type="file" accept="image/*" />
          <button type="button" {{on "click" (fn this.uploadModalImage "sidebar")}}>上传图片</button>
          {{#if this.uploadError}}
            <p class="community-hub-error">{{this.uploadError}}</p>
          {{/if}}

          <label>选择分类填入 link_url（可选）</label>
          <select {{on "change" (fn this.setCategoryLink "sidebar")}}>
            <option value="">— 不选用分类，手填下方 link_url —</option>
            {{#each this.categories as |cat|}}
              <option value={{cat.id}}>{{cat.name}}</option>
            {{/each}}
          </select>

          <label>跳转 (link_url)</label>
          <Input @value={{this.modalDraft.link_url}} />
        {{/if}}
      </div>

      <div class="community-hub-modal-footer">
        <button type="button" {{on "click" this.saveModalChanges}}>保存</button>
        <button type="button" {{on "click" this.closeModal}} class="is-secondary">取消</button>
      </div>
    </div>
  {{/if}}
</div>
